{{! The page of a symbol of the API reference, in the look of the MkDocs
    Material site (mkdocs.yml) that serves it under api/: its header and tabs,
    its fonts and palette, and the light/dark choice it stores. }}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{#if symbol.name}}{{symbol.name}} - {{/if}}API reference - EasyLocal</title>
<link rel="icon" href="{{site_root (relativize "/index.html")}}assets/branding/favicon.svg">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,700,700i%7CRoboto+Mono:400,400i,700,700i&display=fallback">
{{#each page.inlineStyles}}
<style>
{{{this}}}
</style>
{{/each}}
{{#each page.stylesheets}}
<link rel="stylesheet" href="{{#if external}}{{path}}{{else}}{{relativize (concat "/" path)}}{{/if}}">
{{/each}}
{{#each page.inlineScripts}}
<script>
{{{this}}}
</script>
{{/each}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" defer onload="hljs.highlightAll()"></script>
<script>
// The scheme chosen on the site (Material stores it under the site's path),
// else the system's.
(function(){
    var root = new URL("{{site_root (relativize "/index.html")}}", location);
    var key = root.pathname + ".__palette";
    var scheme;
    try { scheme = JSON.parse(localStorage.getItem(key)).color.scheme; } catch (e) {}
    if (!scheme)
        scheme = matchMedia("(prefers-color-scheme: dark)").matches ? "slate" : "default";
    document.documentElement.setAttribute("data-md-color-scheme", scheme);
    window.easylocalPalette = function(){
        var dark = document.documentElement.getAttribute("data-md-color-scheme") !== "slate";
        var media = dark ? "(prefers-color-scheme: dark)" : "(prefers-color-scheme: light)";
        var scheme = dark ? "slate" : "default";
        document.documentElement.setAttribute("data-md-color-scheme", scheme);
        try {
            localStorage.setItem(key, JSON.stringify({index: dark ? 1 : 0, color: {
                media: media, scheme: scheme, primary: "deep-purple", accent: "deep-purple"}}));
        } catch (e) {}
    };
})();
</script>
</head>
<body>
<header class="el-header">
<div class="el-header__inner">
