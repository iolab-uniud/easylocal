@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/EasyLocalTargets.cmake")

# Core is always installed and intentionally has no third-party dependencies.
set(EasyLocal_Core_FOUND TRUE)

# EasyLocal::EasyLocal is retained as a compatibility facade for pre-S28a
# consumers. It resolves only to EasyLocal::Core.
set(EasyLocal_EasyLocal_FOUND TRUE)

foreach(_easylocal_component IN LISTS EasyLocal_FIND_COMPONENTS)
    if(_easylocal_component STREQUAL "Core"
            OR _easylocal_component STREQUAL "EasyLocal")
        continue()
    endif()

    if(_easylocal_component STREQUAL "ConfigTOML")
        if(@EASYLOCAL_CONFIG_TOML_AVAILABLE@)
            if(NOT @EASYLOCAL_CONFIG_TOML_BUNDLED@)
                include(CMakeFindDependencyMacro)
                find_dependency(tomlplusplus 3.4 CONFIG)
            endif()

            include("${CMAKE_CURRENT_LIST_DIR}/EasyLocalConfigTOMLTargets.cmake")
            set(EasyLocal_ConfigTOML_FOUND TRUE)
        else()
            set(EasyLocal_ConfigTOML_FOUND FALSE)
            set(EasyLocal_NOT_FOUND_MESSAGE
                "Requested EasyLocal component 'ConfigTOML' is not available in this installation")
        endif()
        continue()
    endif()

    if(_easylocal_component STREQUAL "TUI")
        if(@EASYLOCAL_TUI_AVAILABLE@)
            include(CMakeFindDependencyMacro)
            if(@EASYLOCAL_TUI_BUNDLED@)
                find_dependency(
                    ftxui 7 CONFIG
                    PATHS
                        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/ftxui"
                    NO_DEFAULT_PATH
                )
            else()
                find_dependency(ftxui 7 CONFIG)
            endif()

            include("${CMAKE_CURRENT_LIST_DIR}/EasyLocalTUITargets.cmake")
            set(EasyLocal_TUI_FOUND TRUE)
        else()
            set(EasyLocal_TUI_FOUND FALSE)
            set(EasyLocal_NOT_FOUND_MESSAGE
                "Requested EasyLocal component 'TUI' is not available in this installation")
        endif()
        continue()
    endif()

    if(_easylocal_component STREQUAL "REST")
        if(@EASYLOCAL_REST_AVAILABLE@)
            include(CMakeFindDependencyMacro)
            if(@EASYLOCAL_REST_BUNDLED@)
                if(@EASYLOCAL_REST_ASIO_BUNDLED@)
                    set(
                        ASIO_INCLUDE_DIR
                        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/easylocal/third_party/asio"
                    )
                endif()
                # The bundled Crow is the pinned FetchContent version and
                # installs no version file, so no version is requested here.
                find_dependency(
                    Crow CONFIG
                    PATHS
                        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/Crow"
                    NO_DEFAULT_PATH
                )
            else()
                # Crow 1.3 packages ship no version file (see CMakeLists.txt).
                find_package(Crow 1.3 CONFIG QUIET)
                if(NOT Crow_FOUND)
                    find_dependency(Crow CONFIG)
                endif()
            endif()

            include("${CMAKE_CURRENT_LIST_DIR}/EasyLocalRESTTargets.cmake")
            set(EasyLocal_REST_FOUND TRUE)
        else()
            set(EasyLocal_REST_FOUND FALSE)
            set(EasyLocal_NOT_FOUND_MESSAGE
                "Requested EasyLocal component 'REST' is not available in this installation")
        endif()
        continue()
    endif()

    if(NOT DEFINED EasyLocal_${_easylocal_component}_FOUND)
        set(EasyLocal_${_easylocal_component}_FOUND FALSE)
        set(EasyLocal_NOT_FOUND_MESSAGE
            "Requested EasyLocal component '${_easylocal_component}' is not available in this installation")
    endif()
endforeach()

check_required_components(EasyLocal)
